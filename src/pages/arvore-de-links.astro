        </svg>
        <span>Fale pelo WhatsApp</span>
      </a>

      <p class="links-card__tagline">Treinando com respeito e amor aos cães.</p>
    </div>

    <Image src={logo} alt="Cão Belo Adestramento" class="links-page__logo" width={70} height={70} />
  </main>

  <style>
    .links-page {
      position: relative;
      display: flex;
      min-height: 100vh;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      padding: 80px 20px;
      overflow: hidden;
      isolation: isolate;
    }

    .links-page__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
    }
    .links-page__bg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }
    .links-page__bg-overlay {
      position: absolute;
      inset: 0;
      background: color-mix(in srgb, var(--t-footer) 90%, transparent);
    }

    .links-card {
      display: flex;
      width: 100%;
      max-width: 455px;
      min-height: 335px;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      border: 1px solid var(--t-secondary);
      border-radius: 20px;
      background: color-mix(in srgb, var(--t-footer) 30%, transparent);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      padding: 40px 20px;
    }
    @media (min-width: 480px) {
      .links-card {
        padding: 60px;
      }
    }

    .links-card__avatar {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
    }

    .links-card__handle {
      font-family: var(--t-font-sans);
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: #ffffff;
      text-align: center;
    }

    .links-card__socials {
      display: flex;
      gap: 8px;
    }
    .links-card__social-btn {
      display: flex;
      width: 40px;
      height: 40px;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      background: var(--t-secondary);
      color: var(--t-footer);
    }
    .links-card__social-btn:hover {
      filter: brightness(0.95);
    }
    .links-card__social-icon {
      width: 20px;
      height: 20px;
    }

    .links-card__divider {
      width: 100%;
      border-top: 1px solid var(--t-secondary);
    }

    .links-card__link {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      gap: 15px;
      border-radius: 10px;
      background: linear-gradient(
        to right,
        var(--t-secondary),
        color-mix(in srgb, var(--t-complement) 19%, transparent)
      );
      padding: 20px 30px;
      color: var(--t-footer);
      font-family: var(--t-font-sans);
      font-size: 17.6px;
      font-weight: 500;
      text-align: center;
    }
    @media (min-width: 480px) {
      .links-card__link {
        font-size: 19.2px;
      }
    }
    .links-card__link:hover {
      filter: brightness(0.97);
    }
    .links-card__link-icon {
      width: 25px;
      height: 25px;
      flex-shrink: 0;
    }
    .links-card__link span {
      white-space: nowrap;
    }

    .links-card__tagline {
      padding-top: 20px;
      max-width: 290px;
      font-family: var(--t-font-sans);
      font-size: 17.6px;
      font-weight: 600;
      letter-spacing: 0.02em;
      line-height: 22.4px;
      color: #ffffff;
      text-align: center;
    }
    @media (min-width: 480px) {
      .links-card__tagline {
        font-size: 19.2px;
      }
    }

    .links-page__logo {
      width: 70px;
      height: 70px;
      opacity: 0.6;
    }

    :focus-visible {
      outline: 3px solid var(--t-secondary);
      outline-offset: 2px;
      border-radius: 4px;
    }

    @media (prefers-reduced-motion: no-preference) {
      .links-card__social-btn,
      .links-card__link {
        transition:
          filter 0.2s ease,
          transform 0.2s ease;
      }
    }
  </style>
</body>
</html>
