            ></path>
          </svg>
        </a>
        <a
          href={INSTAGRAM}
          target="_blank"
          rel="noopener noreferrer"
          class="links-card__social-btn"
          aria-label="Seguir no Instagram"
          data-tracking="instagram-arvore-de-links"
        >
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="links-card__social-icon">
            <path
              d="M10.0039 5.50781C7.51953 5.50781 5.51562 7.51172 5.51562 9.99609C5.51562 12.4805 7.51953 14.4844 10.0039 14.4844C12.4883 14.4844 14.4922 12.4805 14.4922 9.99609C14.4922 7.51172 12.4883 5.50781 10.0039 5.50781ZM10.0039 12.9141C8.39844 12.9141 7.08594 11.6055 7.08594 9.99609C7.08594 8.38672 8.39453 7.07812 10.0039 7.07812C11.6133 7.07812 12.9219 8.38672 12.9219 9.99609C12.9219 11.6055 11.6094 12.9141 10.0039 12.9141ZM15.7227 5.32422C15.7227 5.90625 15.2539 6.37109 14.6758 6.37109C14.0938 6.37109 13.6289 5.90234 13.6289 5.32422C13.6289 4.74609 14.0977 4.27734 14.6758 4.27734C15.2539 4.27734 15.7227 4.74609 15.7227 5.32422ZM18.6953 6.38672C18.6289 4.98438 18.3086 3.74219 17.2813 2.71875C16.2578 1.69531 15.0156 1.375 13.6133 1.30469C12.168 1.22266 7.83594 1.22266 6.39063 1.30469C4.99219 1.37109 3.75 1.69141 2.72266 2.71484C1.69531 3.73828 1.37891 4.98047 1.30859 6.38281C1.22656 7.82812 1.22656 12.1602 1.30859 13.6055C1.375 15.0078 1.69531 16.25 2.72266 17.2734C3.75 18.2969 4.98828 18.6172 6.39063 18.6875C7.83594 18.7695 12.168 18.7695 13.6133 18.6875C15.0156 18.6211 16.2578 18.3008 17.2813 17.2734C18.3047 16.25 18.625 15.0078 18.6953 13.6055C18.7773 12.1602 18.7773 7.83203 18.6953 6.38672ZM16.8281 15.1562C16.5234 15.9219 15.9336 16.5117 15.1641 16.8203C14.0117 17.2773 11.2773 17.1719 10.0039 17.1719C8.73047 17.1719 5.99219 17.2734 4.84375 16.8203C4.07812 16.5156 3.48828 15.9258 3.17969 15.1562C2.72266 14.0039 2.82813 11.2695 2.82813 9.99609C2.82813 8.72266 2.72656 5.98437 3.17969 4.83594C3.48438 4.07031 4.07422 3.48047 4.84375 3.17187C5.99609 2.71484 8.73047 2.82031 10.0039 2.82031C11.2773 2.82031 14.0156 2.71875 15.1641 3.17187C15.9297 3.47656 16.5195 4.06641 16.8281 4.83594C17.2852 5.98828 17.1797 8.72266 17.1797 9.99609C17.1797 11.2695 17.2852 14.0078 16.8281 15.1562Z"
            ></path>
          </svg>
        </a>
      </div>

      <div class="links-card__divider" role="separator"></div>

      <a
        href={SITE_URL}
        class="links-card__link"
        data-tracking="site-arvore-de-links"
      >
        <svg viewBox="0 0 25 25" fill="currentColor" aria-hidden="true" class="links-card__link-icon">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M11.3281 0.838248C8.72503 1.08341 6.12308 2.32175 4.22015 4.22111C-0.369401 8.80201 -0.354704 16.2365 4.25291 20.8084C5.58568 22.1309 7.07361 23.0382 8.8867 23.6339C13.7861 25.2435 19.1734 23.4254 22.1294 19.1651C24.1969 16.1849 24.7663 12.3684 23.6555 8.93556C23.305 7.85246 22.9129 7.03346 22.2879 6.07911C19.8926 2.42204 15.7163 0.424918 11.3281 0.838248ZM12.1472 2.41007C11.1898 2.76716 10.227 4.46945 9.62781 6.86476C9.43812 7.62317 9.2932 8.38302 9.33148 8.41882C9.40975 8.49201 11.0117 8.56686 12.5 8.56686C13.9882 8.56686 15.5902 8.49201 15.6685 8.41882C15.7068 8.38302 15.5618 7.62317 15.3722 6.86476C14.82 4.65725 13.9616 3.03957 13.0632 2.51305C12.7987 2.35808 12.4052 2.31383 12.1472 2.41007ZM9.03318 2.95636C7.05608 3.67351 5.29349 5.05075 4.08016 6.82652C3.93314 7.04167 3.85706 7.19611 3.88494 7.22272C4.07312 7.40226 7.63104 8.30324 7.73626 8.19802C7.74876 8.18546 7.82669 7.83049 7.90936 7.4092C8.07753 6.55241 8.35487 5.53166 8.60907 4.83399C8.78904 4.34 9.1346 3.53698 9.24506 3.35621C9.44417 3.03019 9.56985 2.78351 9.53573 2.78567C9.51444 2.78698 9.28831 2.86383 9.03318 2.95636ZM15.5541 3.01033C15.6278 3.14055 15.7182 3.29621 15.7549 3.35621C15.8654 3.53698 16.2109 4.34 16.3908 4.83399C16.6451 5.53166 16.9225 6.55241 17.0907 7.4092C17.1732 7.83049 17.2507 8.18507 17.2629 8.19713C17.3722 8.30641 20.9163 7.40944 21.1151 7.22219C21.2115 7.13121 20.3328 5.97975 19.6472 5.2987C18.4963 4.15558 17.0087 3.25475 15.5346 2.80827L15.4198 2.77355L15.5541 3.01033ZM2.86497 9.31574C2.30379 11.0273 2.20033 12.7079 2.54578 14.5002C2.6474 15.0274 3.05892 16.3574 3.1204 16.3574C3.13948 16.3574 3.51635 16.2385 3.9579 16.0929C4.85686 15.7966 5.83562 15.5473 6.87327 15.3506L7.56976 15.2185L7.54436 15.0678C7.49266 14.761 7.42229 13.2808 7.42229 12.5C7.42229 11.7193 7.49266 10.239 7.54436 9.93234L7.56976 9.78161L6.87327 9.64948C5.83562 9.45265 4.85686 9.20343 3.9579 8.90719C3.51635 8.76164 3.13948 8.64259 3.1204 8.64259C3.1013 8.64259 2.98636 8.94552 2.86497 9.31574ZM21