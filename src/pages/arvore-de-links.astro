---
// Árvore de links — página standalone tipo Linktree, sem Header/Footer do
// site (réplica 1:1 do Figma: node 52:49 desktop, 52:128 mobile).
// Mesmo padrão de 404.astro: HTML próprio, sem BaseLayout, sem GTM/Consent
// duplicado (a página não faz parte do funil principal do site).
import { Image } from "astro:assets";
import bgImage from "../assets/images/img-links-bg.webp";
import perfilImage from "../assets/images/img-links-perfil.png";
import logo from "../assets/images/logo-paulo-bernardo.svg";

const waNumber = import.meta.env.PUBLIC_WA_NUMBER || "SEUNUMERO";
const waMessage =
  import.meta.env.PUBLIC_WA_MESSAGE || "Olá! Vi seu site e gostaria de mais informações.";
const WA_LINK = `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`;
const INSTAGRAM = "https://www.instagram.com/paulobernardoadestrador";
const SITE_URL = import.meta.env.PUBLIC_SITE_URL || "https://paulobernardoadestrador.com.br";
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>@paulobernardoadestrador — Cão Belo Adestramento</title>
  <meta
    name="description"
    content="Treinando com respeito e amor aos cães. Acesse o site ou fale pelo WhatsApp com Paulo Bernardo, adestrador em São José dos Campos."
  />
  <link rel="canonical" href={`${SITE_URL}/arvore-de-links`} />
  <link rel="icon" type="image/png" href="/favicon.png" />

  <meta property="og:type" content="profile" />
  <meta property="og:title" content="@paulobernardoadestrador — Cão Belo Adestramento" />
  <meta
    property="og:description"
    content="Treinando com respeito e amor aos cães."
  />
  <meta property="og:url" content={`${SITE_URL}/arvore-de-links`} />

  <style>
    @import "@fontsource/nunito/500.css";
    @import "@fontsource/nunito/600.css";
    @import "../styles/tokens.css";

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: var(--t-font-sans);
      -webkit-font-smoothing: antialiased;
    }
    a {
      text-decoration: none;
      color: inherit;
    }
  </style>
</head>
<body>
  <main class="links-page">
    <div class="links-page__bg" aria-hidden="true">
      <Image src={bgImage} alt="" class="links-page__bg-img" width={1920} height={1200} />
      <div class="links-page__bg-overlay"></div>
    </div>

    <div class="links-card">
      <Image
        src={perfilImage}
        alt="Paulo Bernardo, adestrador de cães"
        class="links-card__avatar"
        width={90}
        height={90}
      />

      <p class="links-card__handle">@paulobernardoadestrador</p>

      <div class="links-card__socials">
        <a
          href={WA_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="links-card__social-btn"
          aria-label="Falar no WhatsApp"
          data-tracking="whatsapp-arvore-de-links"
        >
          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="links-card__social-icon">
            <path
