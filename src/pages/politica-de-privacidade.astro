---
// Política de Privacidade — página standalone (header e footer próprios).
// Adequada à LGPD (Lei nº 13.709/2018).
//
// Dados do responsável já preenchidos: CNPJ 37.040.687/0001-07,
// e-mail ph_bernardo@yahoo.com.br. Hospedagem: Vercel. Formulário: FormSubmit.

import { Image } from "astro:assets";
import logoImg from "../assets/images/logo-paulo-bernardo.svg";

const currentYear = new Date().getFullYear();
const SITE_URL = import.meta.env.PUBLIC_SITE_URL || "https://paulobernardoadestrador.com.br";
const DOMINIO = SITE_URL.replace(/^https?:\/\//, "");
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />

  <title>Política de Privacidade | Paulo Bernardo — Adestrador de Cães</title>
  <meta name="description" content="Política de privacidade do site de Paulo Bernardo, adestrador de cães em São José dos Campos." />

  <link rel="canonical" href={`${SITE_URL}/politica-de-privacidade`} />
  <link rel="icon" type="image/png" href="/favicon.png" />

  <style>
    @import "@fontsource/nunito/400.css";
    @import "@fontsource/nunito/600.css";
    @import "@fontsource/barlow-condensed/700.css";
    @import "../styles/tokens.css";

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      font-family: var(--t-font-sans);
      font-weight: 400;
      background: var(--t-surface);
      color: var(--t-text-main);
      -webkit-font-smoothing: antialiased;
      padding-top: 100px;
    }

    /* ── Header ──────────────────────────────────── */
    header {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 50;
      background: var(--t-background);
      border-bottom: 1px solid var(--t-border);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .header-content {
      max-width: 1280px;
      width: 100%;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
    }

    header .logo {
      display: flex;
      align-items: center;
      text-decoration: none;
    }

    header .logo:focus-visible {
      outline: 2px solid var(--t-primary);
      outline-offset: 4px;
    }

    header .logo img {
      height: 52px;
      width: auto;
      display: block;
      /* Isola a camada de composição: sem isso, o Chrome deixa um artefato
         de rasterização (uma faixa amarela) na base do SVG por causa do
         header em position:fixed. */
      transform: translateZ(0);
    }

    header .back {
      font-size: 0.82rem;
      color: var(--t-text-soft);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color 0.2s ease;
    }

    header .back:hover { color: var(--t-primary); }
    header .back:focus-visible { outline: 2px solid var(--t-primary); outline-offset: 2px; }

    /* ── Main ────────────────────────────────────── */
    main {
      max-width: 720px;
      margin: 0 auto;
      padding: 80px 24px 80px;
      width: 100%;
    }

    /* ── Tipografia ──────────────────────────────── */
    h1 {
      font-family: var(--t-font-serif);
      font-size: 2.4rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--t-text-main);
      margin-bottom: 12px;
    }

    .updated {
      font-size: 0.8rem;
      color: var(--t-text-muted);
      margin-bottom: 48px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
    }

    h2 {
      font-family: var(--t-font-serif);
      font-size: 1.5rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--t-text-main);
      margin-top: 44px;
      margin-bottom: 16px;
    }

    p, li {
      font-size: 16px;
      line-height: 1.75;
      color: var(--t-text-soft);
      margin-bottom: 14px;
    }

    ul { padding-left: 24px; margin-bottom: 16px; }
    li { margin-bottom: 8px; }

    a {
      color: var(--t-text-main);
      text-decoration: none;
      transition: opacity 0.2s ease;
      border-bottom: 2px solid var(--t-secondary);
    }

    a:hover { opacity: 0.75; }
    a:focus-visible { outline: 2px solid var(--t-primary); outline-offset: 2px; }
    strong { font-weight: 600; color: var(--t-text-main); }

    /* ── Footer ──────────────────────────────────── */
    footer {
      text-align: center;
      padding: 32px 24px;
      border-top: 1px solid var(--t-border);
      font-size: 0.75rem;
      color: var(--t-text-muted);
      background: var(--t-background);
      line-height: 1.6;
      margin-top: 60px;
    }

    /* ── Responsive ──────────────────────────────── */
    @media (max-width: 640px) {
      body { padding-top: 80px; }
      .header-content { padding: 10px 16px; }
      header .logo img { height: 40px; }
      h1 { font-size: 1.9rem; }
      h2 { font-size: 1.2rem; }
      p, li { font-size: 15px; }
      main { padding: 60px 16px 60px; }
    }

    @media (prefers-reduced-motion: reduce) {
      a { transition: none; }
    }
  </style>
</head>
<body>
  <header>
    <div class="header-content">
      <a href="/" aria-label="Ir para o início" class="logo">
        <Image src={logoImg} alt="Cão Belo Adestramento" width={118} height={118} loading="eager" />
      </a>
      <a href="/" class="back">← Voltar</a>
    </div>
  </header>

  <main>
    <h1>Política de Privacidade</h1>
    <p class="updated">
      Última atualização: {new Date().toLocaleDateString("pt-BR", { month: "long", year: "numeric" })}
    </p>

    <p>
      Esta Política de Privacidade descreve como <strong>Paulo Bernardo</strong>
      (Cão Belo Adestramento), responsável pelo site <strong>{DOMINIO}</strong>,
      coleta, usa e protege as informações dos usuários, em conformidade com a Lei
      Geral de Proteção de Dados (LGPD — Lei nº 13.709/2018).
    </p>

    <h2>1. Dados coletados</h2>
    <p>Coletamos os seguintes dados ao navegar neste site:</p>
    <ul>
      <li>Dados de navegação (páginas acessadas, tempo de visita, dispositivo) via Google Analytics / Google Ads, quando o usuário consente.</li>
      <li>Dados fornecidos voluntariamente ao clicar em links de contato (WhatsApp), que são processados diretamente pelo WhatsApp.</li>
      <li>Nome, sobrenome, e-mail, telefone e mensagem informados no formulário "Solicite seu contrato", usados apenas para envio do contrato e retorno do atendimento.</li>
    </ul>
    <p>Não coletamos dados sensíveis como dados bancários ou informações de saúde por este site.</p>

    <h2>2. Finalidade do uso</h2>
    <ul>
      <li>Melhorar a experiência de navegação com base em dados agregados de acesso.</li>
      <li>Mensurar o desempenho de campanhas de marketing digital (Google Ads).</li>
      <li>Responder a dúvidas e solicitações de contato enviadas voluntariamente.</li>
    </ul>

    <h2>3. Base legal</h2>
    <p>O tratamento dos dados é baseado no consentimento do usuário (Art. 7º, I da LGPD), que pode ser retirado a qualquer momento por meio do nosso aviso de cookies ou pelo contato informado abaixo.</p>

    <h2>4. Cookies</h2>
    <p>Utilizamos cookies de análise e publicidade (Google Analytics e Google Ads), ativados apenas após o consentimento expresso do usuário. Cookies estritamente necessários para o funcionamento do site são sempre ativos.</p>
    <p>Para gerenciar suas preferências de cookies, utilize o banner exibido na primeira visita.</p>

    <h2>5. Compartilhamento de dados</h2>
    <p>Seus dados podem ser compartilhados com:</p>
    <ul>
      <li>Google LLC (Analytics e Ads), conforme os termos de uso destes serviços.</li>
      <li>FormSubmit (formsubmit.co) — serviço que encaminha as mensagens do formulário de contato para o e-mail do responsável.</li>
      <li>Vercel Inc. — provedor de hospedagem e infraestrutura do site.</li>
    </ul>
    <p>Não vendemos nem cedemos seus dados a terceiros para fins comerciais.</p>

    <h2>6. Seus direitos</h2>
    <p>De acordo com a LGPD, você tem direito a:</p>
    <ul>
      <li>Confirmar a existência de tratamento de seus dados.</li>
      <li>Acessar, corrigir ou solicitar a exclusão dos seus dados.</li>
      <li>Revogar o consentimento a qualquer momento.</li>
      <li>Solicitar a portabilidade dos dados.</li>
    </ul>
    <p>Para exercer seus direitos, entre em contato: <a href="mailto:ph_bernardo@yahoo.com.br">ph_bernardo@yahoo.com.br</a></p>

    <h2>7. Segurança</h2>
    <p>Adotamos medidas técnicas e administrativas adequadas para proteger seus dados pessoais contra acesso não autorizado, perda ou destruição.</p>

    <h2>8. Contato</h2>
    <p>
      Paulo Bernardo — Cão Belo Adestramento<br />
      CNPJ: 37.040.687/0001-07<br />
      E-mail: <a href="mailto:ph_bernardo@yahoo.com.br">ph_bernardo@yahoo.com.br</a>
    </p>
  </main>

  <footer>© {currentYear} Paulo Bernardo — Cão Belo Adestramento</footer>
</body>
</html>
