---
import { Image } from "astro:assets";
import assinaturaAdsgator from "../../assets/images/assinatura-adsgator-fundo-escuro.svg";
import logo from "../../assets/images/logo-paulo-bernardo.svg";

const INSTAGRAM = "https://www.instagram.com/paulobernardoadestrador";
const INSTAGRAM_HANDLE = "@paulobernardoadestrador";
const year = new Date().getFullYear();
---

<footer id="footer" class="bg-footer text-white">
  <div class="container-wide">
    <div class="flex flex-col gap-5 pt-10 md:flex-row">
      <div class="flex flex-col justify-center gap-5 md:flex-1">
        <Image
          src={logo}
          alt="Cão Belo Adestramento"
          class="h-[117.59px] w-[117.59px]"
          width={118}
          height={118}
        />
        <!-- Sem padding-right: a linha mais longa mede 352.8px e qualquer
             recuo extra dentro dos 406px da coluna faz "ao" cair sozinho
             na linha seguinte, quebrando o texto em 4 linhas. -->
        <p class="font-sans text-[17.6px] font-medium leading-[22.88px] text-white">
          Cão Belo Adestramento. Atendimento com<br class="hidden md:inline" />
          autoridade e excelência, respeito ao cão e ao<br class="hidden md:inline" />
          seu tutor.
        </p>
      </div>

      <!-- A coluna vazia do meio existe no design para empurrar a caixa do
           Instagram para a direita. -->
      <div class="hidden md:block md:flex-1" aria-hidden="true"></div>

      <div
        class="flex flex-col justify-center gap-5 rounded-[20px] border border-secondary px-5 py-[23.03px] md:flex-1"
      >
        <a
          href={INSTAGRAM}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-start gap-3 self-start transition-opacity hover:opacity-80"
        >
          <svg
            class="mt-0.5 h-[22px] w-[22px] shrink-0 text-secondary"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <line x1="17.5" y1="6.5" x2="17.5" y2="6.5" stroke-linecap="round" stroke-width="2.5" />
          </svg>
          <span class="flex flex-col gap-[3px]">
            <span class="font-sans text-[15px] font-semibold leading-[18px] text-secondary">
              Siga meu instagram
            </span>
            <span class="font-sans text-[16px] leading-[24px] text-white">
              {INSTAGRAM_HANDLE}
            </span>
          </span>
        </a>

        <h3 class="font-serif text-[32px] font-bold uppercase leading-[32px] tracking-normal text-secondary">
          Horário de Atendimento
        </h3>
        <p class="font-sans text-[17.6px] font-medium leading-[22.88px] text-white">
          Segunda a Sexta-feira: 6h às 21h<br />
          Sábado: 9h às 12h
        </p>
      </div>
    </div>

    <!-- Barra inferior (node 1778:690): divisor Dove Gray, copyright amarelo
         à esquerda, assinatura da agência à direita e os links legais
         centralizados numa linha própria embaixo. -->
    <div class="mt-5 border-t border-text-soft pt-[27px]">
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
        <!-- No mobile o texto quebra em duas linhas: centraliza para não
             ficar desalinhado da assinatura logo abaixo. -->
        <span class="text-center font-sans text-[16px] font-medium leading-[17.6px] tracking-[0.04em] text-secondary sm:text-left">
          © Todos os direitos reservados. Paulo Bernardo {year}
        </span>

        <a
          href="https://adsgator.com.br"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-opacity hover:opacity-80"
        >
          <Image
            src={assinaturaAdsgator}
            alt="Criado por Adsgator"
            class="h-[26px] w-[211px]"
            width={211}
            height={26}
          />
        </a>
      </div>

      <!-- py-2 nos links garante os 44px mínimos de área de toque. -->
      <nav
        class="flex flex-wrap justify-center gap-x-6 pb-[22px] pt-4 font-sans text-[13px] text-white/45"
        aria-label="Páginas legais"
      >
        <a href="/politica-de-privacidade" class="py-2 transition-colors hover:text-white/80">
          Política de Privacidade
        </a>
        <a href="/termos-de-uso" class="py-2 transition-colors hover:text-white/80">Termos de Uso</a>
      </nav>
    </div>
  </div>

  <!-- Barra amarela de 12px que fecha a página. -->
  <div class="h-3 w-full bg-secondary"></div>
</footer>
