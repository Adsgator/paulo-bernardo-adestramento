---
import { Image } from "astro:assets";
import logoBichoBrasil from "../../assets/images/parceiro-bicho-brasil.webp";

// Link do parceiro — confirmar a URL oficial com o cliente.
const BICHO_BRASIL_URL = "https://www.bichobrasil24h.com.br";
---

<section id="parceiros" class="bg-background">
  <div class="container-wide pb-20 pt-2.5" data-animate>
    <!-- Gradiente do Figma: -16deg, navy no início e verde no fim.
         O conteúdo do card aparece em sequência curta (data-animate-group). -->
    <div
      class="flex flex-col items-center gap-5 rounded-[40px] bg-[linear-gradient(-16deg,#1d396b_0%,#00a85a_100%)] p-5 text-center md:flex-row md:text-left"
      data-animate-group
    >
      <div class="flex w-full max-w-[430px] shrink-0 items-center justify-center px-6" data-animate-item>
        <Image
          src={logoBichoBrasil}
          alt="Hospital Veterinário Bicho Brasil 24h"
          class="h-auto w-full"
          width={430}
          height={148}
        />
      </div>

      <div class="flex w-full flex-col gap-5 p-2.5">
        <h2 class="font-serif text-[32px] font-extrabold uppercase leading-[32px] tracking-[0.01em] text-white" data-animate-item>
          Parceiro em cuidado e saúde animal
        </h2>
        <p class="max-w-[590px] font-sans text-[19.2px] font-medium leading-[22.4px] text-white" data-animate-item>
          O Hospital Veterinário Bicho Brasil 24h é referência em atendimento
          veterinário completo, com estrutura moderna e profissionais dedicados.
        </p>
        <a
          href={BICHO_BRASIL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] w-full max-w-[296.63px] items-center justify-center self-center rounded-[10px] bg-secondary px-5 pb-2.5 pt-[9px] font-sans text-[17.6px] font-semibold leading-[17.6px] text-primary-dark transition-all duration-300 hover:brightness-95 md:self-start"
          data-animate-item
        >
          Site Bicho Brasil 24h
        </a>
      </div>
    </div>
  </div>
</section>
